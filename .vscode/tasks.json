{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "venv: セットアップ",
      "type": "shell",
      "command": "/opt/homebrew/opt/python@3.13/bin/python3.13 -m venv .venv && .venv/bin/pip install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/app"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
